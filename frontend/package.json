{
  "name": "frontend",
  "version": "0.0.1",
  "description": "Portfolio Optimizer frontend",
  "productName": "Portfolio Optimizer",
  "author": "bdunks <brian.duncan@gmail.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "prettier --write \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore --ignore-path .prettierignore && eslint --fix -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "lint:check": "prettier --check \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore --ignore-path .prettierignore && eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@lucide/vue": "^1.72.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/charts": "1.5.0",
    "@tanstack/vue-form": "1.33.5",
    "@tanstack/vue-query": "5.107.1",
    "@tanstack/vue-table": "9.3.1",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "^0.5.2",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-checker": "^1.0.0",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "keywords": [
    "portfolio-optimizer",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}
